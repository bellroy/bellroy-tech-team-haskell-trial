{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["nix"],
  "includePaths": ["flake.nix", "flake.lock"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 0"]
  },
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "nix and lockfiles"
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "nix and lockfiles"
    }
  ]
}
